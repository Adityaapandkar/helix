# Copy this file to `.env` (in backend/) and fill in your values.
#   cp .env.example .env

# --- Anthropic (required) ---
# Used by every pydantic-ai agent in core/agents/
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Any Claude model ID supported by your account, e.g. claude-sonnet-5-5
ANTHROPIC_MODEL_NAME=claude-sonnet-5-5

# --- Logfire (optional) ---
# Write token for https://logfire.pydantic.dev — traces every agent/tool call.
# Leave empty to run without sending telemetry.
LOGFIRE_API_KEY=

# --- Paths (optional) ---
# Where AlphaFold structures are downloaded and fpocket writes its output.
# Relative paths resolve from the directory you start the server in (backend/).
PDB_FILES_DIR=pdb_files
