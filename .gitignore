# =============================================================
#  Helix — monorepo .gitignore (Python backend + Next.js frontend)
# =============================================================

# ---------- Secrets / environment ----------
.env
.env.*
!.env.example
.envrc

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
*.code-workspace

# =============================================================
#  Python (backend/)
# =============================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging (anchored so they never match frontend/lib etc.)
/backend/build/
/backend/dist/
/backend/develop-eggs/
/backend/eggs/
/backend/.eggs/
/backend/lib/
/backend/lib64/
/backend/parts/
/backend/sdist/
/backend/var/
/backend/wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version
__pypackages__/

# Test / coverage / type-check caches
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log

# ---------- Helix runtime output (regenerated on every run) ----------
/backend/pdb_files/
/backend/helix_output/
/backend/docking_results/
/backend/molecule_files/
/backend/molecules/
/backend/logs/

# =============================================================
#  JavaScript / Next.js (frontend/)
# =============================================================
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/frontend/.next/
/frontend/out/
/frontend/build/
.vercel/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Misc
coverage/
*.pem
